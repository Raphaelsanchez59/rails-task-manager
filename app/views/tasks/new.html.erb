<h1>New task</h1>

<%= form_with model: @task do |f| %>
  <div>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :details %>
    <%= f.text_field :details %>
  </div>

  <%= f.submit "Create Task" %>
<% end %>

<p><%= link_to "Back to list", tasks_path %></p>
